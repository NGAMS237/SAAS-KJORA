# Projet Supabase Kjora uniquement — ne jamais réutiliser les valeurs VERALUZ.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# URL publique du site commercial, utilisée seulement pour le lien de retour
# de la console. Ce n'est pas un secret.
KJORA_COMMERCIAL_SITE_URL=https://kjorapp.com

# Email transactionnel serveur uniquement — jamais préfixer par NEXT_PUBLIC_.
RESEND_TRANSACTIONAL_API_KEY=
KJORA_TRANSACTIONAL_EMAIL_FROM=KJORA <notifications@mail.kjorapp.com>

# Worker documents financiers — garder false pendant la migration et les tests Production.
KJORA_FINANCIAL_EMAIL_DELIVERY_ENABLED=false
# Cron quotidien unique (/api/cron/daily-communications) : « Bearer CRON_SECRET »,
# 16 caractères minimum, sinon toujours 401.
CRON_SECRET=
SUPABASE_SECRET_KEY=

# NOTIFICATIONS-COMMUNICATIONS-E2E-01
# Secret de signature des webhooks Resend (format whsec_…), serveur uniquement.
# Absent : /api/webhooks/resend répond 503 et n'écrit rien.
RESEND_WEBHOOK_SECRET=
# Factures SaaS XAF automatiques : false = le passage quotidien ne fait que
# compter (dry-run). true = création réelle des factures « open ».
KJORA_SAAS_AUTO_INVOICING_ENABLED=false

# Support bêta — destinataire des demandes envoyées depuis /app/support.
# Serveur uniquement. Si absente, l'API répond 503 et le formulaire l'annonce
# honnêtement au lieu d'échouer en silence.
KJORA_SUPPORT_EMAIL_TO=

# -----------------------------------------------------------------------------
# Providers de paiement SaaS — SANDBOX UNIQUEMENT (ALIGN-04A)
# -----------------------------------------------------------------------------
# Serveur uniquement. Ne jamais préfixer par NEXT_PUBLIC_ : un secret provider
# exposé au navigateur est un secret compromis.
#
# Ce fichier ne contient que des NOMS. Ne jamais y écrire une valeur, ni la
# committer ailleurs. Les clés live et les webhooks de Production sont hors
# périmètre : le code refuse le mode live (voir provider-config.ts).
#
# Un provider n'est considéré configuré que si SES DEUX variables sont
# présentes : sans secret de webhook, aucun événement ne serait vérifiable.
#
# Webhook attendu sur : /api/billing/webhooks/<provider>

FLUTTERWAVE_SANDBOX_SECRET_KEY=
FLUTTERWAVE_SANDBOX_WEBHOOK_SECRET=

CAMPAY_SANDBOX_SECRET_KEY=
CAMPAY_SANDBOX_WEBHOOK_SECRET=

ELYONPAY_SANDBOX_SECRET_KEY=
ELYONPAY_SANDBOX_WEBHOOK_SECRET=

# Coupe-circuit (kill switch) — REVENUE-01F. Absentes ou différentes de "1",
# aucun effet : le comportement est identique à avant leur introduction.
# BILLING_KILL_SWITCH_ALL=1 coupe tous les providers (checkout ET webhooks).
# BILLING_KILL_SWITCH_<PROVIDER_EN_MAJUSCULES>=1 coupe un seul provider.
BILLING_KILL_SWITCH_ALL=1
BILLING_KILL_SWITCH_FLUTTERWAVE=
BILLING_KILL_SWITCH_CAMPAY=
BILLING_KILL_SWITCH_ELYONPAY=

# Stripe Canada/diaspora — environnement Test uniquement. L'intégration reste
# fermée tant que BILLING_PROVIDER_STRIPE_TEST_ENABLED n'est pas exactement 1.
BILLING_PROVIDER_STRIPE_TEST_ENABLED=0
STRIPE_SANDBOX_SECRET_KEY=
STRIPE_SANDBOX_WEBHOOK_SECRET=
BILLING_KILL_SWITCH_STRIPE=1
KJORA_APP_ORIGIN=https://kjorapp.com
STRIPE_TEST_PRICE_ESSENTIEL_MONTHLY_CAD=
STRIPE_TEST_PRICE_ESSENTIEL_ANNUAL_CAD=
STRIPE_TEST_PRICE_AVANCE_MONTHLY_CAD=
STRIPE_TEST_PRICE_AVANCE_ANNUAL_CAD=
STRIPE_TEST_PRICE_PATRIMOINE_MONTHLY_CAD=
STRIPE_TEST_PRICE_PATRIMOINE_ANNUAL_CAD=

# WhatsApp officiel futur — fondation désactivée. Ces noms ne suffisent jamais
# à activer un adapter ; un lot fournisseur revu séparément sera nécessaire.
KJORA_WHATSAPP_PROVIDER=disabled
KJORA_WHATSAPP_ACCESS_TOKEN=
KJORA_WHATSAPP_PHONE_NUMBER_ID=
KJORA_WHATSAPP_WEBHOOK_SECRET=
KJORA_PARTNERS_HASH_SALT=

# Adresse de contact affichée publiquement sur /contact et /mentions-legales.
# Exposée au navigateur : n'y mettre qu'une adresse destinée à être publique.
# Si absente, les pages renvoient vers le support intégré.
NEXT_PUBLIC_KJORA_CONTACT_EMAIL=

# -----------------------------------------------------------------------------
# Identité légale de l'émetteur des factures SaaS (REVENUE-LAUNCH-01 v3)
# -----------------------------------------------------------------------------
# Serveur uniquement. Le marchand légal n'est PAS tranché : aucune entité n'est
# codée en dur. Tant que KJORA_BILLING_LEGAL_NAME est vide, les factures PDF
# affichent « émetteur légal non configuré — document provisoire ».
# Renseigner uniquement les valeurs officielles de l'entité retenue.
KJORA_BILLING_LEGAL_NAME=
KJORA_BILLING_LEGAL_ADDRESS=
KJORA_BILLING_LEGAL_REGISTRATION=
KJORA_BILLING_LEGAL_TAX_ID=
KJORA_BILLING_LEGAL_CONTACT_EMAIL=
